        <mxCell id="3VtPT8euKseMFIJPbHYm-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Nivel 2&lt;div&gt;Realizar el traspaso de los bytes del archivo&lt;/div&gt;" vertex="1">
